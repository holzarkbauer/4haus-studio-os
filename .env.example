# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Spotify Web API & Web Playback SDK Configuration (Client-side PKCE OAuth Flow)
# Create a Spotify Developer App at: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=

# Fish Audio TTS Configuration for Daniel 1.0 Voice Cloning
# Optional: Add your Fish Audio API Key and Voice Model Reference ID for zero-shot / cloned TTS
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=



# Claude (Anthropic) para Daniel. Si está vacía, Daniel usa Gemini (GEMINI_API_KEY).
# Nunca escribas la clave real aquí: va solo en el archivo .env o en el panel de tu hosting.
ANTHROPIC_API_KEY=

# Control de gasto de Daniel (valores por defecto si se dejan vacíos)
DANIEL_DAILY_BUDGET_USD=5
DANIEL_DAILY_REQUESTS=40
DANIEL_DAILY_RESEARCH=5

# Seguridad (server/auth.ts)
# ID del proyecto de Firebase para verificar sesiones (si se deja vacío, se lee de firebase-applet-config.json).
FIREBASE_PROJECT_ID=
# UIDs de Firebase con permiso de administrador, separados por comas (p. ej. para cambiar la voz maestra de Daniel).
ADMIN_UIDS=
